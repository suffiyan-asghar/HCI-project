{
  "name": "studybot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "preserver": "node scripts/require-node.cjs",
    "prestart": "node scripts/require-node.cjs",
    "precheck": "node scripts/require-node.cjs",
    "server": "node --env-file-if-exists=.env --watch-path=server server/index.js",
    "build": "vite build",
    "build:static": "vite build --mode static",
    "start": "vite build && node --env-file-if-exists=.env server/index.js",
    "check": "node --env-file-if-exists=.env scripts/check.js",
    "test": "node --test \"test/*.test.js\"",
    "questions:sheet": "node scripts/question-sheet.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "groq-sdk": "^1.6.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@vitejs/plugin-react": "^4.3.3",
    "vite": "^5.4.10"
  }
}
