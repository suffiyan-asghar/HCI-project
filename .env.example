# Copy to .env on the server laptop.

# Groq key for the live tutor. Without it the tutor uses canned replies.
GROQ_API_KEY=

# Protects starting sessions and the /admin page. Each study laptop asks for it once.
RESEARCHER_PASSWORD=

# Optional: TUTOR_MODEL=openai/gpt-oss-120b   TUTOR_MODE=mock   PORT=3000   DB_PATH=data/studybot.sqlite
